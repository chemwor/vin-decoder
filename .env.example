# Copy to .env and adjust as needed. All values below are the defaults.

# Path to the SQLite cache file.
VIN_DB_PATH=vin_cache.db

# vPIC base URL. Point at a stub for local/offline development.
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Per-attempt upstream timeout, in seconds.
VPIC_TIMEOUT_SECONDS=8

# Retries in addition to the first attempt (transient failures only).
VPIC_MAX_RETRIES=2

# Cache entry lifetime in seconds. 0 = never expire.
CACHE_TTL_SECONDS=0

# Reject VINs containing I, O or Q (true to real VINs, stricter than the spec).
STRICT_VIN_CHARSET=false

# --- recalls / safety ratings ---

# api.nhtsa.gov hosts both; a different host from vPIC.
NHTSA_RECALLS_BASE_URL=https://api.nhtsa.gov/recalls
NHTSA_RATINGS_BASE_URL=https://api.nhtsa.gov/SafetyRatings

# Lifetime of a cached year/make/model recall profile, in seconds. Unlike a
# VIN decode this is NOT immutable -- new campaigns land against old cars --
# so it expires by default. 0 = never expire.
PROFILE_TTL_SECONDS=86400

# --- underwriting thresholds (business calls, not facts) ---

# Campaign count at or above which a vehicle goes to manual review.
UW_RECALL_COUNT_REFER=5

# NCAP overall stars at or below which a vehicle goes to manual review.
UW_MIN_NCAP_STARS=2

# NCAP rollover probability at or above which a vehicle goes to review.
UW_ROLLOVER_POSSIBILITY_REFER=0.30

# Campaigns announced within this many days are flagged as least likely to
# have been remedied. 0 disables the check.
UW_RECENT_RECALL_DAYS=365
