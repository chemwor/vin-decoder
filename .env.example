# Copy to .env and adjust as needed. All values below are the defaults.

# Path to the SQLite cache file.
VIN_DB_PATH=vin_cache.db

# vPIC base URL. Point at a stub for local/offline development.
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Per-attempt upstream timeout, in seconds.
VPIC_TIMEOUT_SECONDS=8

# Retries in addition to the first attempt (transient failures only).
VPIC_MAX_RETRIES=2

# Cache entry lifetime in seconds. 0 = never expire.
CACHE_TTL_SECONDS=0

# Reject VINs containing I, O or Q (true to real VINs, stricter than the spec).
STRICT_VIN_CHARSET=false
